# PromptHash auxiliary server (Express + MongoDB)
# Copy to server/.env when running the backend locally.

# Required for server features (draft lifecycle, buyer collections, chat)
MONGODB_URI=mongodb://127.0.0.1:27017/prompt-hash-stellar

# Optional — email notifications
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Optional — S3 backup (see docs/operations/backup-and-recovery.md)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# Backup/restore (S3-compatible storage)
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
BACKUP_S3_REGION=us-east-1
BACKUP_MANIFEST_SIGNING_KEY=
BACKUP_RPO_HOURS=26
BACKUP_RTO_MINUTES=60

# Readiness thresholds for GET /health (see server/src/services/healthService.ts)
INDEXER_STALENESS_MINUTES=15
INDEXER_QUARANTINE_THRESHOLD=25
HEALTH_CHECK_TIMEOUT_MS=3000

# --- Report review / shared admin principal (#146) ---
# HMAC secret for verified admin principal tokens (>= 32 chars). Required to
# authorize GET /api/prompts/reports. Generate with: openssl rand -hex 32
# ADMIN_PRINCIPAL_SECRET=
# Optional comma-separated revoked token ids (jti)
# ADMIN_PRINCIPAL_REVOKED_JTIS=
